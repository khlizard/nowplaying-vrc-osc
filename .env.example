# nowplaying-vrc-osc — 旧 CLI 版（Python）の環境変数（任意）
# GUI 版（DJ Now Playing for VRChat）では使いません。説明: docs/python-cli.ja.md

# 取得方式: auto（config.json 監視、失敗時 Socket.IO）| config | socketio
NP_SOURCE=auto

# NP2 config.json のパス（省略時: ~/.nowplaying/config.json）
# NP_CONFIG_PATH=C:\Users\<ユーザー名>\.nowplaying\config.json

# config.json 監視のポーリング間隔（秒）
NP_POLL_INTERVAL=0.5

# Socket.IO URL（省略時: config.json の localSocketPort から自動。無ければ http://localhost:9000）
# ポートは NP2 の設定に合わせる
# NP_URL=http://localhost:<ポート>

# VRChat OSC 送信先
VRC_OSC_HOST=127.0.0.1
VRC_OSC_PORT=9000

# Chatbox 通知音（/chatbox/input の第3引数。true / false）
VRC_CHATBOX_NOTIFICATION=false

# 入力中インジケーター（/chatbox/typing を送信前後に使う。true / false）
VRC_CHATBOX_INDICATOR=false

# Chatbox メッセージ: ヘッダ（既定: 🎵）
NP_MSG_HEADER=🎵

# Chatbox メッセージ: 項目間の区切り（既定: -）。送信時は前後にスペースが付く（例: " - "）
NP_MSG_SEPARATOR=-

# Chatbox メッセージ: 表示項目（カンマ区切り: title,artist,album,label,comment）
NP_MSG_FIELDS=title,artist

# 曲名（title）内の [～] を除去（true / false）
NP_STRIP_TITLE_BRACKETS=true

# 非推奨: true のとき label を NP_MSG_FIELDS に追加（[label] 形式には戻さない）
NP_SHOW_LABEL=false
