# nowplaying-vrc-osc — 環境変数（任意）

# 取得方式: auto（config.json 監視、失敗時 Socket.IO）| config | socketio
NP_SOURCE=auto

# NP2 config.json のパス（省略時: ~/.nowplaying/config.json）
# NP_CONFIG_PATH=C:\Users\user\.nowplaying\config.json

# config.json 監視のポーリング間隔（秒）
NP_POLL_INTERVAL=0.5

# Socket.IO URL（省略時: config.json の localSocketPort から自動）
# NP_URL=http://localhost:29000

# VRChat OSC 送信先
VRC_OSC_HOST=127.0.0.1
VRC_OSC_PORT=9000

# Chatbox 通知音（/chatbox/input の第3引数。true / false）
VRC_CHATBOX_NOTIFICATION=false

# 入力中インジケーター（/chatbox/typing を送信前後に使う。true / false）
VRC_CHATBOX_INDICATOR=false
