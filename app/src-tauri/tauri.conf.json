{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DJ Now Playing for VRChat",
  "mainBinaryName": "NowPlayingVrcOsc",
  "version": "../package.json",
  "identifier": "com.tokageworks.nowplayingvrcosc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DJ Now Playing for VRChat",
        "url": "index.html",
        "width": 460,
        "height": 170,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
