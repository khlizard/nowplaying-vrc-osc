<Window x:Class="NowPlayingVrcOsc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Now Playing → VRChat" Height="250" Width="540"
        Icon="/Assets/app.ico"
        ResizeMode="CanMinimize"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="状態:" FontWeight="Bold"/>
            <TextBlock x:Name="StatusText" Text="停止中" Margin="0,2,0,10"/>

            <TextBlock Text="現在の曲:" FontWeight="Bold"/>
            <TextBlock x:Name="CurrentTrackText" Text="—" TextWrapping="Wrap" Margin="0,2,0,10"/>

            <TextBlock Text="最終送信:" FontWeight="Bold"/>
            <TextBlock x:Name="LastSentText" Text="—" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="StartButton"    Grid.Column="0" Content="開始"       Margin="0,0,4,0" Click="StartButton_Click"/>
            <Button x:Name="StopButton"     Grid.Column="1" Content="停止"       Margin="4,0,4,0" IsEnabled="False" Click="StopButton_Click"/>
            <Button x:Name="TestSendButton" Grid.Column="2" Content="テスト送信" Margin="4,0,4,0" Click="TestSendButton_Click"/>
            <Button x:Name="SettingsButton" Grid.Column="3" Content="設定..."    Margin="4,0,0,0" Click="SettingsButton_Click"/>
        </Grid>
    </Grid>
</Window>
